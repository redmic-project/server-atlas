IMAGE_NAME=registry.gitlab.com/redmic-project/server/atlas
IMAGE_TAG=latest

UNIT_NAME=atlas
MICROSERVICE_PORT=8080
SPRING_KAFKA_CLIENT_ID={{.Service.Name}}-{{.Task.Slot}}
JAVA_OPTS=-XX:MaxRAMFraction=2

TRAEFIK_ENABLE=true
TRAEFIK_ENTRYPOINT=http
TRAEFIK_SUBDOMAIN=api
PUBLIC_HOSTNAME=change.me

VOL_DRIVER=local
VOL_TYPE=nfs
VOL_ADDR=127.0.0.1
VOL_VERS=4.2
VOL_OPTS=nolock,noacl,noatime,nodiratime
